# Copia in `.env` (non versionato) e adatta. Tutte le chiavi hanno prefisso TT_.

# --- Persistenza ---
# Sviluppo (default): SQLite locale.
# TT_DATABASE_URL=sqlite:///./transito.db
# Produzione / stack docker-compose:
# TT_DATABASE_URL=postgresql+psycopg://transito:transito@localhost:5432/transito

# --- Cache ---
# Vuoto → cache in-memory. Con docker-compose:
# TT_REDIS_URL=redis://localhost:6379/0

# --- Scheduler / motore alert ---
# In produzione gira nel processo dedicato `python -m app.worker`.
# Questo flag lo avvia dentro l'API (solo sviluppo, una replica).
# TT_SCHEDULER_ENABLED=true
# TT_IMMINENT_INTERVAL_S=15
# TT_STRIKE_INTERVAL_S=3600
# TT_SERVICE_ALERT_INTERVAL_S=300

# --- Push FCM/APNs (M4) ---
# Richiede una service account Firebase (vedi secrets/README.md). Spento di default.
# TT_FCM_ENABLED=true
# TT_FCM_CREDENTIALS_FILE=secrets/firebase-admin.json
# In alternativa al file (hosting senza disco), il contenuto JSON su una riga:
# TT_FCM_CREDENTIALS_JSON={"type": "service_account", ...}
# TT_PUSH_INTERVAL_S=10

# --- Sorgenti dati (override solo se gli URL ufficiali cambiano) ---
# TT_GTFS_STATIC_URL=...
# TT_RT_VEHICLE_POSITIONS_URL=...
# TT_RT_TRIP_UPDATES_URL=...
# TT_RT_ALERTS_URL=...
# TT_STRIKES_RSS_URL=...

# --- Keep-alive (hosting free che si spegne senza traffico, vedi docs/DEPLOY.md) ---
# Su Render si attiva da solo leggendo RENDER_EXTERNAL_URL.
# TT_KEEPALIVE_URL=https://example.onrender.com
# TT_KEEPALIVE_INTERVAL_S=600

# --- Varie ---
# TT_LOG_LEVEL=info
# TT_RETRY_BACKOFF_S=300   # attesa prima di ritentare un download GTFS/scioperi fallito
